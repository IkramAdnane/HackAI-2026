from pathlib import Path
import json

src="/mnt/data/text_to_speech_tts.ipynb"
dst="/mnt/data/fixed_text_to_speech_tts.ipynb"

with open(src,"r",encoding="utf-8") as f:
    nb=json.load(f)

widgets=nb.get("metadata",{}).get("widgets",{})
key="application/vnd.jupyter.widget-state+json"

if key in widgets:
    data=widgets[key]
    if "state" not in data:
        widgets[key]={"state":data}
else:
    nb.setdefault("metadata",{}).pop("widgets",None)

with open(dst,"w",encoding="utf-8") as f:
    json.dump(nb,f,ensure_ascii=False,indent=1)

print(dst)
